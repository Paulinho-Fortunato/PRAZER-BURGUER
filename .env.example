# FLASK CONFIGURATION
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=your-super-secret-key-here-min-32-chars

# DATABASE - MONGODB ATLAS
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/prazer_burguer?retryWrites=true&w=majority
MONGODB_DB_NAME=prazer_burguer

# ADMIN CREDENTIALS
ADMIN_EMAIL=admin@prazerburguer.ao
ADMIN_PASSWORD_HASH=your-secure-hash-here

# RATE LIMITING
RATE_LIMIT=10 per minute

# WHATSAPP API
WHATSAPP_BUSINESS_PHONE_ID=your-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-account-id
WHATSAPP_API_TOKEN=your-api-token
WHATSAPP_MESSAGE_TEMPLATE_ID=your-template-id
WHATSAPP_BUSINESS_NUMBER=+244924123456

# SECURITY
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# SENTRY (ERROR TRACKING)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# PRODUCTION
PORT=5000
HOST=0.0.0.0
